# GenResearch backend environment
# Supabase remains required for authentication and application data.

CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Modal hosts the OpenAI-compatible DeepSeek endpoint. Keep these credentials
# only in backend/.env and rotate any credentials that have been shared.
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=
MODAL_BASE_URL=https://abbasi-kaleem2002--ep-deepseek-v4-1-flash-1017-server.us-west.modal.direct/v1
MODAL_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
# Keep reasoning out of the completion budget for predictable workflow output.
MODAL_REASONING_EFFORT=none
MODAL_SUMMARIZATION_REASONING_EFFORT=none
MODAL_LITERATURE_REVIEW_REASONING_EFFORT=none
MODAL_TOP_P=0.9
MODAL_MAX_TOKENS=16384
MODAL_CONTEXT=32768
MODAL_MAX_CONCURRENT=2
MODAL_CONNECT_TIMEOUT=10
MODAL_READ_TIMEOUT=180

# Ollama is used only for document and query embeddings.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CONNECT_TIMEOUT=5
OLLAMA_REQUEST_TIMEOUT=600
OLLAMA_KEEP_ALIVE=30m
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_PREFIXES=true

# Chat routing and retrieval
DOC_STRUCTURE_ON_UPLOAD=True
CHAT_INTENT_ROUTING=True
DOC_STRUCTURE_VERSION=1
CHAT_MAP_MAX_CONCURRENCY=2
CHAT_MAP_WINDOW_CHARS=2666
CHAT_TOP_K=8
CHAT_BROAD_TOP_K=12
CHAT_FETCH_MULTIPLIER=3
CHAT_MAX_DISTANCE=0.75
CHAT_HISTORY_TURNS=6
CHAT_CONTEXT_CHARS=10000

# ChromaDB and chunking
CHROMA_PERSIST_PATH=./chroma_db
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# Supply these Supabase values in backend/.env.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
